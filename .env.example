# Copy to .env.local and fill in. Only the PUBLIC anon key goes here.
# NEVER put the service-role key in any VITE_* variable — it would be shipped to browsers.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Development only: lets you preview the learning environment without Supabase.
# It is IGNORED in production builds. Progress is stored in this browser only.
# VITE_DEV_DEMO=true
